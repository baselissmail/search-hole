{
  "description": "Golden match fixtures (ADR-0008 'Domain matching', spoof cases). Each case: a rule's match expression, a result URL, and whether the rule must match.",
  "cases": [
    { "match": "pinterest.com", "url": "https://pinterest.com/pin/1", "matches": true, "note": "the host itself" },
    { "match": "pinterest.com", "url": "https://www.pinterest.com/pin/1", "matches": true, "note": "a subdomain" },
    { "match": "pinterest.com", "url": "https://a.b.pinterest.com/", "matches": true, "note": "a deep subdomain" },
    { "match": "pinterest.com", "url": "https://notpinterest.com/", "matches": false, "note": "no label boundary (SearXNG's unanchored re.search bug)" },
    { "match": "pinterest.com", "url": "https://pinterest.com.evil.example/", "matches": false, "note": "the rule's domain as a prefix of another host" },
    { "match": "pinterest.com", "url": "https://pinterest.com。evil.example/", "matches": false, "note": "ideographic full stop maps to '.' under IDNA" },
    { "match": "pinterest.com", "url": "https://pinterest.com%2eevil.example/", "matches": false, "note": "percent-encoded dot in the host" },
    { "match": "pinterest.com", "url": "https://evil.example/pinterest.com/", "matches": false, "note": "domain in the path" },
    { "match": "pinterest.com", "url": "https://evil.example/?u=https://pinterest.com/", "matches": false, "note": "domain in the query" },
    { "match": "pinterest.com", "url": "https://pinterest.com@evil.example/", "matches": false, "note": "domain as userinfo" },
    { "match": "pinterest.com", "url": "https://pіnterest.com/", "matches": false, "note": "Cyrillic i (xn--pnterest-thh.com) is a different host" },
    { "match": "pinterest.com", "url": "https://xn--pnterest-thh.com/", "matches": false, "note": "the same spoof already in punycode" },
    { "match": "pinterest.com", "url": "https://ｐｉｎｔｅｒｅｓｔ.com/", "matches": true, "note": "fullwidth letters are the same host after IDNA mapping" },
    { "match": "pinterest.com", "url": "https://PINTEREST.COM./x", "matches": true, "note": "upper case and a trailing dot" },
    { "match": "pinterest.com", "url": "https://pinterest.com:8443/x", "matches": true, "note": "a non-default port" },
    { "match": "pinterest.com", "url": "http://pinterest.com:80/x", "matches": true, "note": "the default port" },
    { "match": "pinterest.com", "url": "https://pinterest.co/", "matches": false, "note": "a shorter TLD" },
    { "match": "PINTEREST.com.", "url": "https://www.pinterest.com/", "matches": true, "note": "the rule is normalised too" },
    { "match": "*.pinterest.com", "url": "https://pinterest.com/", "matches": true, "note": "uBlacklist: *.d also matches d itself" },
    { "match": "*.pinterest.com", "url": "https://www.pinterest.com/", "matches": true, "note": "uBlacklist: *.d matches subdomains" },
    { "match": "*.pinterest.com", "url": "https://notpinterest.com/", "matches": false, "note": "*.d keeps the label boundary" },
    { "match": "bücher.de", "url": "https://xn--bcher-kva.de/", "matches": true, "note": "a Unicode rule matches the punycode host" },
    { "match": "xn--bcher-kva.de", "url": "https://BÜCHER.de/", "matches": true, "note": "a punycode rule matches a Unicode URL" },
    { "match": "com", "url": "https://pinterest.com/", "matches": true, "note": "a bare TLD (Goggles site=rs style)" },
    { "match": "=example.com", "url": "https://example.com./", "matches": true, "note": "exact host, trailing dot stripped" },
    { "match": "=example.com", "url": "https://www.example.com/", "matches": false, "note": "exact host excludes subdomains" },
    { "match": "=www.example.com", "url": "https://www.example.com/a", "matches": true, "note": "hosts-file www entry: exact host" },
    { "match": "=www.example.com", "url": "https://example.com/a", "matches": false, "note": "hosts-file www entry does not cover the apex" },
    { "match": "=www.example.com", "url": "https://cdn.www.example.com/a", "matches": false, "note": "hosts-file www entry does not cover subdomains" },
    { "match": "1.2.3.4", "url": "http://1.2.3.4/x", "matches": true, "note": "an IPv4 domain rule matches that address" },
    { "match": "2.3.4", "url": "http://1.2.3.4/x", "matches": false, "note": "IP addresses have no label suffixes" },
    { "match": "github.com/orgname/", "url": "https://github.com/orgname/repo", "matches": true, "note": "host + path prefix" },
    { "match": "github.com/orgname/", "url": "https://gist.github.com/orgname/x", "matches": true, "note": "host_path covers subdomains" },
    { "match": "github.com/orgname/", "url": "https://github.com/orgname-evil/repo", "matches": false, "note": "path prefix" },
    { "match": "github.com/orgname", "url": "https://github.com/orgnamefoo", "matches": false, "note": "a prefix without a trailing slash keeps a segment boundary" },
    { "match": "github.com/orgname", "url": "https://github.com/orgname?tab=repos", "matches": true, "note": "query after the segment" },
    { "match": "github.com/orgname", "url": "https://github.com/orgname", "matches": true, "note": "exact path" },
    { "match": "github.com/OrgName/", "url": "https://github.com/orgname/repo", "matches": false, "note": "path case is kept" },
    { "match": "=github.com/orgname/", "url": "https://gist.github.com/orgname/x", "matches": false, "note": "exact host + path" },
    { "match": "example.com/über/", "url": "https://example.com/%C3%BCber/x", "matches": true, "note": "rule paths are percent-encoded like result URLs" },
    { "match": "|https://*.example.*/amp/^", "url": "https://news.example.com/amp/", "matches": true, "note": "ADR-0008 /amp/ example" },
    { "match": "|https://*.example.*/amp/^", "url": "https://m.example.co.uk/amp/?x=1", "matches": true, "note": "ADR-0008 /amp/ example with a query" },
    { "match": "|https://*.example.*/amp/^", "url": "https://news.example.com/amp/story", "matches": false, "note": "^ needs a separator or the end after /amp/" },
    { "match": "|https://*.example.*/amp/^", "url": "http://news.example.com/amp/", "matches": false, "note": "the leading | anchors the scheme" },
    { "match": "|https://*.example.*/amp/^", "url": "https://example.com/amp/", "matches": false, "note": "*. requires a subdomain in a URL pattern" },
    { "match": "|https://*.example.*/amp/^", "url": "https://NEWS.EXAMPLE.COM/amp/#frag", "matches": true, "note": "host case and the fragment do not matter" },
    { "match": "|https://*.example.*/amp/^", "url": "https://evil.example/x.example.y/amp/", "matches": false, "note": "a host * never runs into the path (spoof)" },
    { "match": "|https://*.pinterest.com/", "url": "https://www.pinterest.com/x", "matches": true, "note": "ADR-0008 subdomains-only idiom" },
    { "match": "|https://*.pinterest.com/", "url": "https://pinterest.com/", "matches": false, "note": "subdomains only: not the apex" },
    { "match": "|https://*.pinterest.com/", "url": "https://evil.example/a.pinterest.com/", "matches": false, "note": "a host * stops at the first '/' (spoof)" },
    { "match": "|*://*.pinterest.com/", "url": "http://www.pinterest.com/", "matches": true, "note": "a scheme wildcard" },
    { "match": "|*://*.pinterest.com/", "url": "https://evil.example/?u=https://www.pinterest.com/", "matches": false, "note": "a scheme * stays inside the scheme (spoof)" },
    { "match": "*/amp/*", "url": "https://x.example/a/amp/b", "matches": true, "note": "unanchored * keeps Goggles semantics" },
    { "match": "/foo.js^", "url": "https://cdn.example/foo.js?v=1", "matches": true, "note": "Goggles ^ separator" },
    { "match": "/foo.js^", "url": "https://cdn.example/foo.jsx", "matches": false, "note": "Goggles ^ does not match a letter" },
    { "match": "example.org^", "url": "https://example.org.ac/", "matches": false, "note": "Goggles ^ does not match '.'" },
    { "match": "||example.com^", "url": "https://www.example.com/x", "matches": true, "note": "ABP host anchor" },
    { "match": "||example.com^", "url": "https://notexample.com/", "matches": false, "note": "ABP host anchor keeps the label boundary" },
    { "match": "|https://example.com/|", "url": "https://example.com/", "matches": true, "note": "both anchors" },
    { "match": "|https://example.com/|", "url": "https://example.com/x", "matches": false, "note": "the trailing | anchors the end" },
    { "match": "/^https?:\\/\\/www\\./", "url": "https://www.example.com/", "matches": true, "note": "uBlacklist regex keeps www. (lossless normalisation)" },
    { "match": "/^https?:\\/\\/www\\./", "url": "https://example.com/www./", "matches": false, "note": "anchored regex" },
    { "match": "/-tutorial-.*\\.xyz$/", "url": "https://learn-tutorial-now.xyz", "matches": false, "note": "regex runs over the URL with its path ('/')" },
    { "match": "/-tutorial-.*\\.xyz$/", "url": "https://x.com/a-tutorial-b.xyz", "matches": true, "note": "regex over the URL path" },
    { "match": "/EXAMPLE/i", "url": "https://example.com/", "matches": true, "note": "the i flag" },
    { "match": "/EXAMPLE/", "url": "https://example.com/", "matches": false, "note": "regex is case-sensitive by default" }
  ]
}
