{
  "description": "ADR-0008 precedence table. Every rule matches the URL unless it sets 'match'. 'rule', 'pin' and 'weightRule' are indexes into 'rules' (null = none). List rules name their list; lists default to mode enforce, kind block. Clock: 2026-10-30T00:00:00Z.",
  "url": "https://www.example.com/docs/page",
  "now": "2026-10-30T00:00:00Z",
  "cases": [
    { "name": "no rules: kept", "rules": [], "expect": { "visibility": "kept", "rule": null } },
    { "name": "list block hides", "rules": [{ "scope": "list", "action": "block" }], "expect": { "visibility": "hidden", "rule": 0, "hiddenReason": "list" } },
    { "name": "global block hides", "rules": [{ "scope": "global", "action": "block" }], "expect": { "visibility": "hidden", "rule": 0, "hiddenReason": "rule" } },
    { "name": "user allow beats list block", "rules": [{ "scope": "global", "action": "allow" }, { "scope": "list", "action": "block" }], "expect": { "visibility": "kept", "rule": 0 } },
    { "name": "user allow beats list $important block", "rules": [{ "scope": "global", "action": "allow" }, { "scope": "list", "action": "block", "listImportant": true }], "expect": { "visibility": "kept", "rule": 0 } },
    { "name": "user block beats list allow", "rules": [{ "scope": "global", "action": "block" }, { "scope": "list", "action": "allow" }], "expect": { "visibility": "hidden", "rule": 0, "hiddenReason": "rule" } },
    { "name": "user pin beats list block", "rules": [{ "scope": "project", "action": "pin" }, { "scope": "list", "action": "block", "listImportant": true }], "expect": { "visibility": "kept", "rule": 0, "pin": 0 } },
    { "name": "lists: allow beats block", "rules": [{ "scope": "list", "action": "block", "list": "a" }, { "scope": "list", "action": "allow", "list": "b" }], "expect": { "visibility": "kept", "rule": 1 } },
    { "name": "lists: $important block beats allow", "rules": [{ "scope": "list", "action": "allow", "list": "a" }, { "scope": "list", "action": "block", "listImportant": true, "list": "b" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "list" } },
    { "name": "lists: important allow beats $important block (AdGuard)", "rules": [{ "scope": "list", "action": "block", "listImportant": true, "list": "a" }, { "scope": "list", "action": "allow", "listImportant": true, "list": "b" }], "expect": { "visibility": "kept", "rule": 1 } },
    { "name": "session beats global", "rules": [{ "scope": "session", "action": "allow" }, { "scope": "global", "action": "block" }], "expect": { "visibility": "kept", "rule": 0 } },
    { "name": "session block beats global allow", "rules": [{ "scope": "session", "action": "block" }, { "scope": "global", "action": "allow" }], "expect": { "visibility": "hidden", "rule": 0, "hiddenReason": "rule" } },
    { "name": "project beats global", "rules": [{ "scope": "global", "action": "allow" }, { "scope": "project", "action": "block" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "rule" } },
    { "name": "session beats project", "rules": [{ "scope": "project", "action": "allow" }, { "scope": "session", "action": "block" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "rule" } },
    { "name": "global important beats session", "rules": [{ "scope": "session", "action": "allow" }, { "scope": "global", "action": "block", "important": true }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "rule" } },
    { "name": "session important beats global important", "rules": [{ "scope": "global", "action": "block", "important": true }, { "scope": "session", "action": "allow", "important": true }], "expect": { "visibility": "kept", "rule": 1 } },
    { "name": "within a tier: allow beats block", "rules": [{ "scope": "global", "action": "block" }, { "scope": "global", "action": "allow" }], "expect": { "visibility": "kept", "rule": 1 } },
    { "name": "within a tier: block beats pin", "rules": [{ "scope": "global", "action": "pin" }, { "scope": "global", "action": "block" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "rule", "pin": null } },
    { "name": "within a tier: allow beats block even when the block is more specific", "rules": [{ "scope": "global", "action": "block", "match": "=www.example.com" }, { "scope": "global", "action": "allow", "match": "example.com" }], "expect": { "visibility": "kept", "rule": 1 } },
    { "name": "lower never un-hides a list block", "rules": [{ "scope": "global", "action": "lower", "weight": 2 }, { "scope": "list", "action": "block" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "list", "weightRule": 0 } },
    { "name": "raise alone keeps and weights", "rules": [{ "scope": "global", "action": "raise", "weight": 3 }], "expect": { "visibility": "kept", "rule": null, "weightRule": 0, "factor": 1.45 } },
    { "name": "pin from a lower user tier still pins", "rules": [{ "scope": "session", "action": "allow" }, { "scope": "global", "action": "pin" }], "expect": { "visibility": "kept", "rule": 0, "pin": 1 } },
    { "name": "a list pin never pins", "rules": [{ "scope": "list", "action": "pin" }], "expect": { "visibility": "kept", "rule": 0, "pin": null } },
    { "name": "profile-scoped allow skipped for another profile", "profile": "news", "rules": [{ "scope": "global", "action": "allow", "profiles": ["coding"] }, { "scope": "list", "action": "block" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "list" } },
    { "name": "profile-scoped allow applies to its profile", "profile": "coding", "rules": [{ "scope": "global", "action": "allow", "profiles": ["coding"] }, { "scope": "list", "action": "block" }], "expect": { "visibility": "kept", "rule": 0 } },
    { "name": "expired allow is skipped", "rules": [{ "scope": "global", "action": "allow", "until": "2026-10-29" }, { "scope": "list", "action": "block" }], "expect": { "visibility": "hidden", "rule": 1, "hiddenReason": "list" } },
    { "name": "until covers its whole day", "rules": [{ "scope": "global", "action": "block", "until": "2026-10-30" }], "expect": { "visibility": "hidden", "rule": 0, "hiddenReason": "rule" } },
    { "name": "non-matching rules are ignored", "rules": [{ "scope": "global", "action": "block", "match": "notexample.com" }], "expect": { "visibility": "kept", "rule": null } },
    { "name": "allowlist mode hides unmatched", "profile": "strict", "rules": [], "expect": { "visibility": "hidden", "rule": null, "hiddenReason": "allowlist_mode" } },
    { "name": "allowlist mode keeps a user allow", "profile": "strict", "rules": [{ "scope": "global", "action": "allow" }], "expect": { "visibility": "kept", "rule": 0 } },
    { "name": "allowlist mode keeps a list allow", "profile": "strict", "rules": [{ "scope": "list", "action": "allow", "list": "goggle" }], "expect": { "visibility": "kept", "rule": 0 } },
    { "name": "audit list never hides", "rules": [{ "scope": "list", "action": "block", "list": "trial" }], "lists": { "trial": { "mode": "audit" } }, "expect": { "visibility": "kept", "rule": null, "audit": { "wouldBe": "hidden", "rule": 0 } } },
    { "name": "audit allow would show an enforced list block", "rules": [{ "scope": "list", "action": "block", "list": "a" }, { "scope": "list", "action": "allow", "list": "trial" }], "lists": { "trial": { "mode": "audit" } }, "expect": { "visibility": "hidden", "rule": 0, "hiddenReason": "list", "audit": { "wouldBe": "kept", "rule": 1 } } },
    { "name": "audit list cannot override a user rule", "rules": [{ "scope": "global", "action": "allow" }, { "scope": "list", "action": "block", "listImportant": true, "list": "trial" }], "lists": { "trial": { "mode": "audit" } }, "expect": { "visibility": "kept", "rule": 0, "audit": null } },
    { "name": "disabled list is ignored", "rules": [{ "scope": "list", "action": "block", "list": "off" }], "lists": { "off": { "mode": "disabled" } }, "expect": { "visibility": "kept", "rule": null } },
    { "name": "official list annotates, never hides", "rules": [{ "scope": "list", "action": "block", "list": "official-docs" }], "lists": { "official-docs": { "kind": "official" } }, "expect": { "visibility": "kept", "rule": null } },
    { "name": "weight: user weight replaces list weight", "rules": [{ "scope": "global", "action": "lower", "weight": 1 }, { "scope": "list", "action": "raise", "weight": 9 }], "expect": { "visibility": "kept", "weightRule": 0 } },
    { "name": "weight: session normal neutralises global raise", "rules": [{ "scope": "global", "action": "raise", "weight": 5 }, { "scope": "session", "action": "normal" }], "expect": { "visibility": "kept", "weightRule": 1, "factor": 1 } },
    { "name": "weight: important lower beats session raise", "rules": [{ "scope": "session", "action": "raise", "weight": 5 }, { "scope": "global", "action": "lower", "weight": 2, "important": true }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: host+path beats domain inside a tier", "rules": [{ "scope": "global", "action": "raise", "weight": 2, "match": "example.com" }, { "scope": "global", "action": "lower", "weight": 3, "match": "example.com/docs/" }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: URL pattern with a path beats host+path", "rules": [{ "scope": "global", "action": "raise", "weight": 2, "match": "example.com/docs/" }, { "scope": "global", "action": "lower", "weight": 3, "match": "|https://*.example.com/docs/" }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: exact host beats domain suffix", "rules": [{ "scope": "global", "action": "raise", "weight": 4, "match": "www.example.com" }, { "scope": "global", "action": "lower", "weight": 2, "match": "=www.example.com" }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: more labels beat fewer", "rules": [{ "scope": "global", "action": "lower", "weight": 2, "match": "example.com" }, { "scope": "global", "action": "raise", "weight": 1, "match": "www.example.com" }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: file order breaks ties", "rules": [{ "scope": "global", "action": "raise", "weight": 1 }, { "scope": "global", "action": "raise", "weight": 4 }], "expect": { "visibility": "kept", "weightRule": 0 } },
    { "name": "weight: lists, any raise beats any lower", "rules": [{ "scope": "list", "action": "lower", "weight": 1, "list": "a" }, { "scope": "list", "action": "raise", "weight": 1, "list": "b" }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: lists, the largest raise wins", "rules": [{ "scope": "list", "action": "raise", "weight": 5, "list": "a" }, { "scope": "list", "action": "raise", "weight": 2, "list": "b" }], "expect": { "visibility": "kept", "weightRule": 0 } },
    { "name": "weight: lists, the weakest lower wins", "rules": [{ "scope": "list", "action": "lower", "weight": 5, "list": "a" }, { "scope": "list", "action": "lower", "weight": 2, "list": "b" }], "expect": { "visibility": "kept", "weightRule": 1 } },
    { "name": "weight: lists, normal beats a lower", "rules": [{ "scope": "list", "action": "lower", "weight": 2, "list": "a" }, { "scope": "list", "action": "normal", "list": "b" }], "expect": { "visibility": "kept", "weightRule": 1, "factor": 1 } }
  ]
}
