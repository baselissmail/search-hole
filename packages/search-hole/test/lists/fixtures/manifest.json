        },
        {
          "url": "https://blog.example/engineering/post",
          "visibility": "kept",
          "weight": 1.45,
          "note": "path boost 3 beats site downrank 3, no summing"
        },
        {
          "url": "https://blog.example/other",
          "visibility": "kept",
          "weight": 0.6897,
          "note": "site downrank 3 elsewhere"
        },
        { "url": "https://www.reddit.example/r/rust/x", "visibility": "kept", "weight": 1.6 },
        { "url": "https://cdn.example/foo.js?v=1", "visibility": "hidden", "note": "^ separator" },
        { "url": "https://cdn.example/foo.jsx", "visibility": "kept" },
        { "url": "https://amp.news.example/", "visibility": "kept", "weight": 0.7692 },
        {
          "url": "https://learn.example/tutorial/x",
          "visibility": "kept",
          "weight": 1.15,
          "note": "a bare instruction is boost=1"
        },
        {
          "url": "https://big.example/",
          "visibility": "kept",
          "weight": 2.5,
          "note": "boost=12 clamped to 10"
        },
        {
          "url": "https://x.example/",
          "visibility": "kept",
          "weight": 1,
          "note": "invalid instructions skipped"
        }
