    {
      "name": "plain domains",
      "lists": ["dom"],
      "cases": [
        { "url": "https://www.pinterest.example/", "visibility": "hidden", "note": "domain suffix" },
        { "url": "https://medium.example/", "visibility": "hidden" },
        { "url": "https://a.quora.example/", "visibility": "hidden" },
        { "url": "https://bücher.example/", "visibility": "hidden", "note": "IDN entry, punycode match" },
        { "url": "https://example.com/", "visibility": "kept", "note": "single-label 'com' skipped" }
      ]
    },
    {
      "name": "an official list only annotates",
      "lists": ["official"],
      "profiles": [{ "name": "docs", "prefer": { "lists": ["official"] } }],
      "profile": "docs",
      "cases": [
        {
          "url": "https://docs.example/x",
          "visibility": "kept",
          "weight": 1,
          "prefer": 1.45,
          "note": "membership feeds prefer"
        },
        {
          "url": "https://pinterest.example/",
          "visibility": "kept",
          "weight": 1,
          "prefer": 1.45,
          "note": "never hides"
        },
        { "url": "https://other.example/", "visibility": "kept", "weight": 1, "prefer": 1 }
      ]
    },
    {
      "name": "an allow list turns entries into exceptions",
      "lists": ["allowed", "abp"],
      "cases": [
        {
          "url": "https://www.pinterest.example/",
          "visibility": "kept",
          "note": "list allow beats list block"
        },
        {
          "url": "https://ads.example/",
          "visibility": "hidden",
