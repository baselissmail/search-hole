    },
    {
      "name": "hosts file",
      "lists": ["hosts"],
      "cases": [
        {
          "url": "https://www.example.com/",
          "visibility": "hidden",
          "note": "ADR-0008 golden: hosts www. entry"
        },
        {
          "url": "https://example.com/",
          "visibility": "kept",
          "note": "the www. entry does not cover the apex"
        },
        { "url": "https://cdn.www.example.com/", "visibility": "kept", "note": "or subdomains" },
        { "url": "https://ads.example/", "visibility": "hidden" },
        { "url": "https://tracking.example/", "visibility": "hidden" },
        { "url": "https://sub.ads.example/", "visibility": "kept" },
        { "url": "https://telemetry.example/", "visibility": "hidden" },
        { "url": "https://ipv6-sink.example/", "visibility": "hidden" },
        { "url": "https://nas.lan/", "visibility": "kept", "note": "a redirect line is not a block" },
        { "url": "http://localhost/", "visibility": "kept", "note": "reserved names are ignored" }
