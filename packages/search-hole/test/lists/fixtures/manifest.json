    },
    {
      "name": "a user allow beats a goggle discard",
      "lists": ["gg"],
      "user": [{ "match": "pinterest.example", "action": "allow" }],
      "cases": [{ "url": "https://pinterest.example/", "visibility": "kept" }]
    },
    {
      "name": "Goggles allowlist mode",
      "lists": ["ggal"],
      "profiles": [{ "name": "only", "defaultAction": "block" }],
      "profile": "only",
      "cases": [
        {
          "url": "https://docs.example/",
          "visibility": "kept",
          "weight": 1.15,
          "note": "matched by an instruction"
