        { "url": "https://mdn.example/x", "visibility": "kept", "weight": 1.3 },
        { "url": "https://docs.example/ads/x", "visibility": "hidden", "note": "discard stays final" },
        {
          "url": "https://other.example/",
          "visibility": "hidden",
